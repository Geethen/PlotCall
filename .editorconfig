# https://editorconfig.org — the app is edited by hand in several editors and
# `label_app.html` is one 7,000-line file, so a stray tab or a CRLF shows up as
# a diff nobody meant to make.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{html,css,js,json,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# trailing double-space is a hard line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
